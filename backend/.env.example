# Server
PORT=4000
NODE_ENV=development

# Comma separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Auth
JWT_SECRET=change-me-in-production-supersecret
JWT_EXPIRES_IN=7d

# Persistence (JSON file database directory, relative to backend root)
DATA_DIR=data
DATA_FILE=db.json
